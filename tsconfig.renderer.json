  "compilerOptions": {
    "outDir": "dist/renderer",
    "rootDir": "src",
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "references": [{ "path": "./packages/contracts" }],
  "include": [
