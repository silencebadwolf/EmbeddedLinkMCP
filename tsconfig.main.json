{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/main",
    "rootDir": "src",
    "composite": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ]
  },
  "references": [
    {
      "path": "./packages/contracts"
    },
    {
      "path": "./packages/runtime"
    },
    {
      "path": "./packages/mcp"
    }
  ],
  "include": [
    "src/main/**/*.ts",
    "src/mcp/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
