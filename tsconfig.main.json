  "compilerOptions": {
    "outDir": "dist/main",
    "rootDir": "src",
    "composite": true,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "references": [{ "path": "./packages/contracts" }],
  "include": [
    "src/main/**/*.ts",
    "src/core/**/*.ts",
    "src/transports/**/*.ts",
    "src/mcp/**/*.ts",
    "src/jlink/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
