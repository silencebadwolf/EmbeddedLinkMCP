{
  "name": "linkterm-v2",
  "version": "0.1.0",
  "private": true,
  "description": "LinkTerm — desktop and self-hosted Web terminal & MCP automation platform",
  "author": "LinkTerm contributors",
  "homepage": "https://gitee.com/wake_micro/link-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/wake_micro/link-mcp.git"
  },
  "bugs": {
    "url": "https://gitee.com/wake_micro/link-mcp/issues"
  },
  "type": "module",
  "main": "apps/desktop/dist/main/index.js",
  "scripts": {
    "dev": "pnpm dev:desktop",
    "build:contracts": "pnpm --filter @linkterm/contracts build",
    "build": "node scripts/copy-ui-assets.mjs && tsc -b && vite build --config apps/desktop/vite.config.ts && vite build --config apps/web/vite.config.ts",
    "build:main": "tsc -b apps/desktop/tsconfig.main.json tsconfig.main.json",
    "build:renderer": "pnpm run build:packages && vite build --config apps/desktop/vite.config.ts",
    "build:all": "pnpm run build:main && pnpm run build:renderer",
    "start": "node scripts/start-electron.mjs .",
    "doctor:wsl": "node scripts/doctor-wsl.mjs",
    "doctor:jlink": "node scripts/doctor-jlink.mjs",
    "pretest": "node scripts/doctor-wsl.mjs",
    "test": "pnpm run build:packages && vitest run",
    "test:coverage": "node scripts/doctor-wsl.mjs && pnpm run build:packages && vitest run --coverage",
    "test:watch": "pnpm run build:packages && vitest",
    "lint": "eslint src/ apps/ packages/ tests/",
    "format": "prettier --write \"{src,apps,packages,tests}/**/*.{ts,tsx}\"",
    "validate:licenses": "tsx scripts/validate-licenses.ts",
    "sbom": "node scripts/generate-sbom.mjs",
    "release:checksums": "node scripts/generate-checksums.mjs",
    "ci:check": "pnpm run lint && pnpm run build && pnpm run test && pnpm run validate:licenses",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "build:packages": "node scripts/copy-ui-assets.mjs && tsc -b packages/contracts packages/runtime packages/mcp packages/ui",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:desktop": "pnpm --filter @linkterm/desktop build",
    "build:web": "pnpm --filter @linkterm/web build",
    "build:server": "pnpm --filter @linkterm/server build",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:server": "node scripts/dev-web.mjs --server-only",
    "start:server": "node apps/server/dist/index.js",
    "pack:server": "pnpm run build:web && pnpm run build:server && node scripts/pack-server.mjs",
    "dist:desktop": "pnpm run build:desktop && node scripts/pack-desktop.mjs",
    "pack:desktop": "pnpm run build:desktop && node scripts/pack-desktop.mjs --dir",
    "migrate:server:connections": "pnpm run build:server && pnpm --filter @linkterm/server migrate:connections"
  },
  "devDependencies": {
    "@linkterm/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "node-pty": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "serialport": "^13.0.0",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "@linkterm/runtime": "workspace:*",
    "@linkterm/mcp": "workspace:*",
    "@linkterm/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.8",
    "autoprefixer": "^10.4.21",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "happy-dom": "^20.10.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "win32",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  },
  "packageManager": "pnpm@9.15.0",
  "license": "AGPL-3.0-or-later"
}
