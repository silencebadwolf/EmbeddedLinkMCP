{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "快速编译 LinkTerm",
      "type": "shell",
      "command": "python",
      "args": ["scripts/setup_env.py", "--install", "--build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "启动 LinkTerm",
      "type": "shell",
      "command": "python",
      "args": ["scripts/setup_env.py", "--install", "--start"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
