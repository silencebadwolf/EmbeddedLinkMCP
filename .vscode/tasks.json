{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "快速编译 LinkTerm",
      "type": "shell",
      "command": "python",
      "args": ["scripts/setup_env.py", "--install", "--build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "启动 LinkTerm",
      "type": "shell",
      "command": "python",
      "args": ["scripts/setup_env.py", "--install", "--start"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "预览 LinkTerm Renderer",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1", "--configLoader", "native"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "打包 LinkTerm",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dist"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
