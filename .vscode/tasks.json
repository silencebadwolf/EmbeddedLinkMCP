{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "快速编译 LinkTerm",
      "type": "shell",
      "command": "python",
      "args": ["scripts/setup_env.py", "--install", "--build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "启动 LinkTerm",
      "type": "shell",
      "command": "python",
      "args": ["scripts/setup_env.py", "--install", "--start"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "打包 LinkTerm",
      "type": "process",
      "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "python scripts/setup_env.py --install --build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; pnpm run dist; exit $LASTEXITCODE"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "Path": "${env:Path};C:\\Windows\\System32\\WindowsPowerShell\\v1.0"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
